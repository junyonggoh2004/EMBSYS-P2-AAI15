// Copy to wifi_credentials.h (gitignored) and fill in. Without it the node
// runs offline. The ESP32-S3 joins 2.4 GHz WPA2-Personal networks only.
#define WIFI_SSID "YOUR_SSID"
#define WIFI_PASS "YOUR_PASSWORD"
#define MQTT_HOST "YOUR_MQTT_BROKER_IP"
#define MQTT_PORT 1883
#define NODE_ID   "s3-001"   // MQTT topics are pico/<NODE_ID>/...
