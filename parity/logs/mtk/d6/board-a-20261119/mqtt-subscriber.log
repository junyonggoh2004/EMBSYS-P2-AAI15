# D6 Board A, 19 Nov 2026: MQTT subscriber (mosquitto_sub -t pico/s3-001/# -v) during the full Board A test. Config sent as config/board_a.cfg on pico/s3-001/config, then RUN, STOP and PAIR SONAR_A SONAR_B A 5000 on pico/s3-001/cmd. Hotspot on 2.4 GHz (channel 6), broker on the laptop.
pico/s3-001/presence {"node":"s3-001","cap":["config","telemetry","node-msg"]}
pico/s3-001/cmd STOP
pico/s3-001/cmd CLEAR
pico/s3-001/config BEGINCFG|name=AHT|proto=i2c|i2c.sensor=aht|mode=poll|freq_hz=0.5|timing.timeout_ms=600|i2c.sda=1|i2c.scl=2|i2c.addr=0x38|i2c.baud=100000|ENDCFG
BEGINCFG|name=LIGHT|proto=i2c|i2c.sensor=tsl2561|mode=poll|freq_hz=0.5|timing.timeout_ms=600|i2c.sda=1|i2c.scl=2|i2c.addr=0x29|i2c.baud=100000|ENDCFG
BEGINCFG|name=SONAR_A|proto=gpio|gpio.mode=pulse|gpio.trig=10|gpio.echo=11|gpio.pull=down|gpio.trig_us=10|gpio.pulse_timeout_us=20000|mode=poll|freq_hz=2|timing.timeout_ms=100|ENDCFG
BEGINCFG|name=SONAR_B|proto=gpio|gpio.mode=pulse|gpio.trig=6|gpio.echo=7|gpio.pull=down|gpio.trig_us=10|gpio.pulse_timeout_us=20000|mode=poll|freq_hz=2|timing.timeout_ms=100|ENDCFG

pico/s3-001/status/config OK:AHT
pico/s3-001/status/config OK:LIGHT
pico/s3-001/status/config OK:SONAR_A
pico/s3-001/status/config OK:SONAR_B
pico/s3-001/cmd SHOW
pico/s3-001/cmd RUN
pico/s3-001/sensor/SONAR_A/line proto=gpio src=SONAR_A len=3 ts=486420 : 73 02 01
pico/s3-001/sensor/AHT/line proto=i2c src=AHT len=6 ts=486498 : 18 A1 38 26 09 4D
